# Browser-safe, inlined at build time. Committed values live in .env.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_PROJECT_ID="<project-ref>"

# SERVER-ONLY. Bypasses RLS — full database access.
# Set this in the Vercel project settings (Production + Preview) and, for local
# `npm run dev`, in .env.local (gitignored). NEVER put it in .env: this repo is public.
SUPABASE_SECRET_KEY="sb_secret_..."

# Server-only, for the /api/jobs/[id]/summary route (ChatGPT call).
# Set in the Vercel project settings, same as SUPABASE_SECRET_KEY.
OPENAI_API_KEY="sk-..."
# Optional: defaults to gpt-4o-mini.
OPENAI_SUMMARY_MODEL="gpt-4o-mini"
