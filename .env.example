# Browser-safe, inlined at build time. Committed values live in .env.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_PROJECT_ID="<project-ref>"

# SERVER-ONLY. Bypasses RLS — full database access.
# Set this in the Vercel project settings (Production + Preview) and, for local
# `npm run dev`, in .env.local (gitignored). NEVER put it in .env: this repo is public.
SUPABASE_SECRET_KEY="sb_secret_..."

# Server-only, for the /api/jobs/[id]/summary route (ChatGPT call).
# Set in the Vercel project settings, same as SUPABASE_SECRET_KEY.
OPENAI_API_KEY="sk-..."
# Optional: defaults to gpt-4o-mini.
OPENAI_SUMMARY_MODEL="gpt-4o-mini"

# Stripe (M2 — credits). Sandbox/test keys only until M3 go-live.
# Publishable key is browser-safe; secret key and webhook secret are server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Business tier + local upload (Step 3) --------------------------------
# Both flags default OFF; the app then behaves exactly like the M4 release.
NEXT_PUBLIC_PRO_TIER_ENABLED=false
NEXT_PUBLIC_UPLOAD_ENABLED=false
# Credits per started minute for the business tier (must match the worker's
# PRO_CREDITS_PER_MINUTE in the ECS task definition). Standard is always 1.
PRO_CREDITS_PER_MINUTE=2

# S3 access for presigned URLs (browser uploads + editor audio playback).
# IAM user `videoreader-web` — allowed only: PutObject uploads/*, GetObject/
# DeleteObject audio/*, HeadObject uploads/*. Server-only, set in Vercel.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AUDIO_BUCKET=videoreader-artifacts-134580876888

# Vercel Cron sends this as `Authorization: Bearer` to /api/cron/audio-reaper.
CRON_SECRET=<random 32+ chars>

# ECPay 綠界 (NT$ credit purchases). With ECPAY_ENV=stage (default) and the
# three below unset, ECPay's public test merchant 3002607 is used automatically.
# ECPAY_ENV=prod requires real values from the ECPay merchant back office.
ECPAY_ENV=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
